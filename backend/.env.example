# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Server Configuration
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_MAX=10

# Database (Accounts & Saved Schemas - required for Phases 8+)
DATABASE_URL=postgresql://user:password@localhost:5432/ai_schema_designer

# Auth (Sessions - required for Phases 8+)
JWT_SECRET=super_secret_jwt_key_at_least_32_chars_long_change_in_production
JWT_EXPIRES_IN=1h
# COOKIE_SECURE=false for local HTTP development; set to `true` for HTTPS production
